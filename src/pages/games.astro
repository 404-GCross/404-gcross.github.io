---
/**
 * 游戏页（覆盖主题同名页面）。
 *
 * 覆盖原因只有一条：Hikarinagi 的品牌与署名要求——展示通过其接口获取的条目数据时，
 * 必须标注数据来源，并让每个条目指回它在 Hikarinagi 的页面。卡片外链在数据层
 * 已经指向作品页（见 scripts/sync-hikarinagi.mjs），这里补一行显式署名。
 * 主题页面本身没有任何改动，升级主题时只需跟着核对这段。
 *
 * 数据层：shirones/config/data/games.ts（脚本生成）；行为层：gamesConfig。
 */
import GamesSection from "@components/organisms/GamesSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveAsset } from "@utils/asset-utils";
import { resolveI18nText } from "@utils/i18n-utils";
import { gamesConfig } from "@/config/gamesConfig";
import { resolveGamesData } from "@/utils/feature-data";

if (!gamesConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(gamesConfig.title, I18nKey.games);
const pageDescription = resolveI18nText(
	gamesConfig.description,
	I18nKey.gamesBanner,
);

// 构建期解析封面：支持 src/assets 相对路径（走 Astro 图片管线）、
// /public 绝对路径与远程 URL——Svelte 卡片直接拿到可用 URL。
const items = await Promise.all(
	resolveGamesData(gamesConfig).map(async (game) => ({
		...game,
		cover: game.cover ? await resolveAsset(game.cover) : undefined,
	})),
);
---

<MainGridLayout title={pageTitle} description={pageDescription} page="games">
	<GamesSection
		categories={gamesConfig.categories}
		items={items}
		title={pageTitle}
		subtitle={pageDescription}
		client:visible
	/>

	<p class="games-source">
		条目数据来自 <a
			href="https://www.hikarinagi.org"
			target="_blank"
			rel="noopener noreferrer">Hikarinagi</a
		>，每张卡片的外链直达该作品在站内的页面。
	</p>
</MainGridLayout>

<style>
	.games-source {
		margin: 0.75rem 0 0;
		text-align: center;
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--on-surface-variant);
	}

	.games-source a {
		color: var(--primary);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
</style>
