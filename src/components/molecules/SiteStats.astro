---
/**
 * 覆盖主题的 molecules/SiteStats：主题只在关闭系列时隐藏对应统计行，
 * 本站关闭了日记（moments），这里按同样写法把「动态」行一并隐藏。
 * 若上游以后把 momentsConfig.enable 也纳入判断，可以删掉这份覆盖。
 *
 * 站点统计侧栏 widget（规格表风格）。
 * 行 = MetaIcon tonal 徽标 + 标签 + 点线引导 + 表格数字，
 * 与 PostMeta 的元信息语言同源；数据来自 utils/site-stats（备忘化汇总）。
 */
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getSiteStats } from "@utils/site-stats";
import { momentsConfig, seriesConfig, siteConfig } from "@/config";
import type { SiteConfig } from "@/types/config";
import type { StatsWidget } from "@/types/sidebarConfig";
// 相对路径 "./WidgetLayout.astro" 在 package 模式下指不到主题包里，
// 用别名显式指向主题的同名组件。
import WidgetLayout from "@components/molecules/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	widget?: StatsWidget;
}

const className = Astro.props.class;
const style = Astro.props.style;

const stats = await getSiteStats();
// 千位分隔固定 en-US：构建产物数值稳定，不随构建机 locale 漂移
const fmt = (n: number) => n.toLocaleString("en-US");

// 运行天数不用主题的 stats.days：它以「最早一篇文章的发布日」为起点，
// 且在构建时用 Date.now() 算一次写死，文章日期一变或长期不部署就会失准。
// 这里改用配置的站点开始日，按站点时区的自然日数「第 N 天」（开始日即第 1 天）；
// 页面加载后底部脚本会按同一口径再算一次，不重新部署也能每天 +1。
//
// siteStartDate 是我们在 shirones/config/siteConfig.ts 里本地扩展的字段
// （构建时 Vite 会解析到那份覆盖文件），主题类型里没有，故此处断言取用。
const DAY_MS = 86_400_000;
const siteStartDate = (siteConfig as SiteConfig & { siteStartDate: string })
	.siteStartDate;
// 日序号：先取站点时区下的年月日，再按 UTC 零点折算成天数，
// 这样构建机/访客的本地时区与夏令时都不会影响结果。
const dayIndex = (date: Date) => {
	const ymd = new Intl.DateTimeFormat("en-CA", {
		timeZone: siteConfig.timeZone,
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	}).format(date);
	return Math.floor(Date.parse(`${ymd}T00:00:00Z`) / DAY_MS);
};
const runningDays = Math.max(
	1,
	dayIndex(new Date()) - dayIndex(new Date(siteStartDate)) + 1,
);

// 最近更新：SSR 渲染绝对日期（构建产物稳定、无 JS 也可读），
// 页面加载后由底部脚本升级为相对时间（今天/昨天/N 天前）
const lastActivityText = stats.lastActivity
	? formatDateToYYYYMMDD(new Date(stats.lastActivity))
	: "—";
const todayText = i18n(I18nKey.statsToday);
const yesterdayText = i18n(I18nKey.statsYesterday);
const daysAgoText = i18n(I18nKey.statsDaysAgo);

interface StatRow {
	icon: string;
	label: string;
	value: string;
	/** 值为相对时间（今天 / 昨天 / N 天前），由页面脚本改写 */
	relative?: boolean;
	/** 值为运行天数，由页面脚本按站点开始日重算 */
	days?: boolean;
}

const rows: StatRow[] = [
	{
		icon: "material-symbols:article-outline-rounded",
		label: i18n(I18nKey.statsPosts),
		value: fmt(stats.posts),
	},
	// 日记功能关闭时不产出统计行（与系列同款处理）
	...(momentsConfig.enable
		? [
				{
					icon: "material-symbols:forum-outline-rounded",
					label: i18n(I18nKey.moments),
					value: fmt(stats.moments),
				},
			]
		: []),
	{
		icon: "material-symbols:folder-outline-rounded",
		label: i18n(I18nKey.categories),
		value: fmt(stats.categories),
	},
	{
		icon: "material-symbols:tag-rounded",
		label: i18n(I18nKey.tags),
		value: fmt(stats.tags),
	},
	// 系列功能关闭时不产出统计行（零额外负担）
	...(seriesConfig.enable
		? [
				{
					icon: "material-symbols:auto-stories-outline-rounded",
					label: i18n(I18nKey.series),
					value: fmt(stats.series),
				},
			]
		: []),
	{
		icon: "material-symbols:edit-note-outline-rounded",
		label: i18n(I18nKey.statsWords),
		value: fmt(stats.words),
	},
	{
		icon: "material-symbols:calendar-month-outline-rounded",
		label: i18n(I18nKey.statsDays),
		value: fmt(runningDays),
		days: true,
	},
	{
		icon: "material-symbols:update-rounded",
		label: i18n(I18nKey.statsUpdated),
		value: lastActivityText,
		relative: true,
	},
];
---

<WidgetLayout name={i18n(I18nKey.stats)} id="site-stats" class={className} style={style}>
	<ul class="m3-site-stats">
		{rows.map((row) => (
			<li class="m3-site-stats__row">
				<MetaIcon icon={row.icon} />
				<span class="m3-site-stats__label">{row.label}</span>
				<span class="m3-site-stats__rule" aria-hidden="true"></span>
				<span
					class="m3-site-stats__value"
					data-last-update={row.relative ? "" : undefined}
					data-running-days={row.days ? "" : undefined}
					>{row.value}</span
				>
			</li>
		))}
	</ul>
</WidgetLayout>

<style lang="stylus">
.m3-site-stats
	display: flex
	flex-direction: column
	gap: var(--m3e-space-2)
	margin: 0
	padding: 0
	list-style: none

	&__row
		display: flex
		align-items: center
		gap: var(--m3e-space-2)

	&__label
		font: var(--m3e-type-body-medium)
		font-weight: 500
		color: var(--on-surface-variant)
		white-space: nowrap

	/* 点线引导：沉到文字基线附近，长度伸缩填满中段 */
	&__rule
		flex: 1
		align-self: flex-end
		margin-bottom: 0.35em
		min-width: 0.75rem
		border-bottom: 2px dotted var(--outline-variant)

	&__value
		font: var(--m3e-type-title-small)
		font-weight: 600
		font-variant-numeric: tabular-nums
		color: var(--on-surface)
		white-space: nowrap
</style>

<script is:inline define:vars={{ startDate: siteStartDate, timeZone: siteConfig.timeZone, lastActivityISO: stats.lastActivity, todayText, yesterdayText, daysAgoText }}>
	// 运行天数重算：构建时的值只在部署那天准确，这里按站点开始日现算一次
	// （站点时区的自然日，「第 N 天」）；脚本禁用时保留 SSR 的值
	(() => {
		const el = document.querySelector("[data-running-days]");
		if (!el) return;
		const dayIndex = (date) => {
			const ymd = new Intl.DateTimeFormat("en-CA", {
				timeZone,
				year: "numeric",
				month: "2-digit",
				day: "2-digit",
			}).format(date);
			return Math.floor(Date.parse(`${ymd}T00:00:00Z`) / 86_400_000);
		};
		const days = Math.max(
			1,
			dayIndex(new Date()) - dayIndex(new Date(startDate)) + 1,
		);
		el.textContent = days.toLocaleString("en-US");
	})();

	// 最近更新相对化：按本地时区取日界，差值恒为整天数；
	// 无文章或脚本禁用时保留 SSR 的绝对日期
	(() => {
		const el = document.querySelector("[data-last-update]");
		if (!el || !lastActivityISO) return;
		const DAY_MS = 86_400_000;
		const dayStart = (d) =>
			new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
		const diffDays = Math.round(
			(dayStart(new Date()) - dayStart(new Date(lastActivityISO))) / DAY_MS,
		);
		if (diffDays <= 0) el.textContent = todayText;
		else if (diffDays === 1) el.textContent = yesterdayText;
		else el.textContent = daysAgoText.replace("{days}", String(diffDays));
	})();
</script>
